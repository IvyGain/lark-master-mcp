{
  "name": "@ivygain/lark-master-mcp",
  "version": "0.2.4",
  "description": "Lark Master MCP — 49 Lark/Feishu tools for Claude Desktop, VoiceOS, and other MCP clients. Thin wrapper around the official @larksuite/cli.",
  "type": "module",
  "bin": {
    "lark-master-mcp": "./build/index.js"
  },
  "main": "./build/index.js",
  "files": [
    "build/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x ./build/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lark",
    "feishu",
    "claude",
    "voiceos",
    "ai",
    "lark-cli",
    "anthropic"
  ],
  "author": "IvyGain <ivygain.official@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/IvyGain/lark-master-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvyGain/lark-master-mcp.git",
    "directory": "apps/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/IvyGain/lark-master-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@larksuite/cli": ">=1.0.9"
  },
  "peerDependenciesMeta": {
    "@larksuite/cli": {
      "optional": false
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "execa": "^9.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
