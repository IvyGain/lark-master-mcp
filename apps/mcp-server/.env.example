# @ivygain/lark-master-mcp - Optional Environment Variables
# All authentication is handled by lark-cli, NOT by this server.
# Run `lark-cli auth login --domain all` to authenticate.

# Optional: override path to lark-cli binary
# LARK_CLI_BIN=/usr/local/bin/lark-cli

# Optional: default identity for tool calls (user | bot | auto)
# LARK_DEFAULT_IDENTITY=auto

# Optional: override Lark/Feishu domain
# LARK_DOMAIN=https://open.larksuite.com

# Optional: profile metadata storage directory
# LARK_MASTER_PROFILE_DIR=~/.lark-master
