# Optional — override default lark-cli binary location
LARK_CLI_BIN=lark-cli

# Optional — override default profile directory
LARK_MASTER_PROFILE_DIR=~/.lark-master

# Optional — default identity when not specified per-tool-call
# Values: user | bot | auto
LARK_DEFAULT_IDENTITY=auto

# Optional — Lark/Feishu domain. Leave empty to use lark-cli default.
# Lark (International): https://open.larksuite.com
# Feishu (China):        https://open.feishu.cn
LARK_DOMAIN=https://open.larksuite.com

# Optional — if set, the MCP server will refuse to mutate state unless
# the caller passes `confirm: true`. Useful in voiceOS environments.
LARK_MASTER_REQUIRE_CONFIRM=false
